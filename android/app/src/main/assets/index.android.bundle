__d(function(e,t,s,o,i,a,n){i.exports={citizen_input_header:"Nouvel enregistrement",used_app_before:"Avez-vous d\xe9j\xe0 utilis\xe9 cette application ?",yes:"OUI",no:"NON",welcome_login:"Bienvenue! Pour Acc\xe9der \xe0 votre compte, merci de vous identifier",email:"Email",password:"Mot de passe",login:"Nom d'utilisateur",connect:"Se connecter",email_provided:"Veuillez entrer l'adresse email fournie par votre superviseur et utiliser un mot de passe de votre choix.",choose_password:"Choisissez votre mot de passe",enter_new_password:"Entrez votre nouveau mot de passe. Il doit contenir au moins 8 caract\xe8res.",last_validation:"Une derni\xe8re validation est requise!",please_enter_code:"Utilisez le code fourni par votre superviseur",account_create_success:"Votre compte a \xe9t\xe9 cr\xe9\xe9 avec succ\xe8s",logout:"Se d\xe9connecter",diagnostics:"Statistiques",information:"Information",collect_reports:"Collecte Plaintes ou Suggestions",search_reports:"R\xe9sum\xe9 de mes Plaintes",sync_files:"Synchroniser les Fichiers",intro_text_0:"Communique avec le citoyen : ",intro_text_1:"Nous avons inclus des points de discussion pour vous aider \xe0 guider les citoyens tout au long du processus. Pour commencer la session, veuillez envisager d\u2019informer les gens de ce qui suit :  ",intro_text_2:"J\u2019appr\xe9cie que vous soyez venu nous faire part de vos probl\xe8mes concernant le projet. Ce sera rapide - quelques minutes - et facile. Avant de commencer, vous devez savoir certaines choses.\u201d",intro_text_3:"Tout peut \xeatre aussi priv\xe9 et confidentiel que vous le souhaitez. Plus nous avons d\u2019informations, mieux nous pouvons vous aider, mais vous ne devez nous dire que ce que vous \xeates \xe0 l\u2019aise de partager.",intro_text_4:"Tous les d\xe9tails que vous avez qui peuvent nous aider \xe0 localiser et \xe0 r\xe9soudre le probl\xe8me, ou \xe0 apporter des am\xe9liorations sont appr\xe9ci\xe9s, mais ne vous inqui\xe9tez pas si vous ne vous souvenez pas de quelque chose.",intro_text_5:"Votre probl\xe8me sera enregistr\xe9 et attribu\xe9 dans un jour ou deux \xe0 quelqu\u2019un qui sera charg\xe9 de r\xe9pondre \xe0 votre pr\xe9occupation.",intro_text_6:"Nous essayons de r\xe9soudre les probl\xe8mes dans les {x} jours suivant votre signalement, et nous vous aiderons \xe0 suivre et \xe0 suivre votre probl\xe8me.",welcome_citizen_input:"Bienvenue sur le portail du MGP num\xe9rique!",step_1:"\xc9tape 1",stay_touch_question:"M\xe9thode pr\xe9f\xe9r\xe9e de contact",step_1_hint_1:"Communique avec le citoyen : \u201cSi vous le souhaitez, nous pouvons vous informer de l\u2019avancement par SMS ou par e-mail. Mais si vous voulez rester anonyme, nous pouvons vous donner un code, ou vous pouvez revenir vers moi pour faire le suivi. Lequel veux-tu?\u201d",step_1_option_1:"Je ne souhaite pas \xeatre contact\xe9(e)",step_1_option_2:"Recevoir des mises \xe0 jour via le facilitateur",step_1_option_3:"Recevoir des alertes directement",step_1_method_1:"Texte / SMS",step_1_method_2:"WhatsApp",step_1_method_3:"E-mail",step_1_placeholder_1:"M\xe9thode de contact",step_1_placeholder_2:"Entrez les informations ici",contact_step_title:"Information de contact",contact_step_subtitle:"Nom du Plaignant.",contact_step_explanation:"Communique avec le citoyen : \u201cIl est facultatif de fournir votre nom. Si vous ne voulez pas que je l'enregistre, je le laisserai vide.\u201d",contact_step_placeholder_1:"Entrez le nom du plaignant ici",contact_step_placeholder_2:"Entrez le groupe d\u2019\xe2ge (facultatif)",contact_step_placeholder_3:"Choisissez le sexe (facultatif)",contact_step_placeholder_4:"Cette personne d\xe9pose la plainte au nom de quelqu\u2019un d\u2019autre.",contact_step_placeholder_5:"Groupe socio-professionnel (facultatif)",contact_step_placeholder_6:"Niveau d'instuction (facultatif)",step_2:"\xc9tape 2",step_2_subtitle:"D\xe9tails de la plainte",step_2_explanation:"Communique avec le citoyen : \u201cJe souhaite enregistrer les dates des \xe9v\xe9nements que vous signalez. Si vous ne vous souvenez pas des dates exactes, faites de votre mieux et j\u2019en ferai une note sp\xe9ciale. Ne vous inqui\xe9tez pas si vous ne vous souvenez pas de chaque d\xe9tail.\u201d",step_2_ongoing_hint:"\xc9v\xe9nement en cours ou occurrences multiples",step_2_select_date:"Tapez pour s\xe9lectionner la date",step_2_set_today:"Aujourd\u2019hui",step_2_placeholder_1:"Quel signalez-vous?",step_2_placeholder_2:"De quoi s\u2019agit-il?",step_2_placeholder_3:"Veuillez r\xe9sumer le probl\xe8me.",step_2_placeholder_4:"Please provide any additional details.",step_2_placeholder_5:"Quel type?",step_2_placeholder_6:"Composante (facultatif)",step_2_placeholder_7:"Sous Composante (facultatif)",step_2_share_photos:"Partagez toute vid\xe9o, photo ou audio \xe0 l\u2019appui comme preuve ou clarification.\n",step_2_upload_attachment:"Pi\xe8ces jointes",step_2_keep_name_confidential:"Gardez le nom confidentiel. Seule la personne charg\xe9e de r\xe9soudre la plainte verra le nom.",step_2_on_behalf_of_someone:"Il s'agit d'une personne qui remplit ceci pour le compte d'une autre personne.",step_2_organization_behalf_someone:"Il s'agit d'une organisation qui remplit ceci pour le compte d'une autre personne.",step_3:"\xc9tape 3",step_3_confirmation:"Confirmez les d\xe9tails et soumettez",step_3_subtitle:"Communique avec le citoyen : \u201cNous avons presque termin\xe9. Je veux prendre un moment et revoir ce que nous avons captur\xe9. Nous pouvons modifier les informations ou les soumettre.\u201d",step_3_field_title_1:"Date de la plainte:",step_3_field_title_2:"Type de probl\xe8me:",step_3_field_title_2_1:"Sous Typologie:",step_3_field_title_3:"Sujet:",step_3_field_title_4:"Description:",step_3_field_title_5:"Composante:",step_3_field_title_6:"Sous Composante:",step_3_field_title_7:"Groupe Socio-professionnel:",step_3_attachments:"Pi\xe8ces jointes:",step_4:"\xc9tape 4",step_location_description:"O\xf9 cela s\u2019est-il produit ?",step_location_body:"Communique avec le citoyen : vous devez essayer d\u2019obtenir un lieu aussi pr\xe9cis que n\xe9cessaire pour r\xe9soudre le probl\xe8me. Les adresses, les coins de rue, les descriptions du quartier peuvent tous \xeatre utiles. S\u2019il s\u2019agit d\u2019un probl\xe8me confidentiel ou sensible, s\xe9lectionnez simplement les param\xe8tres r\xe9gionaux et ne collectez aucun autre d\xe9tail.",step_location_dropdown_placeholder:"Tapez pour s\xe9lectionner",step_location_input_explanation:"Veuillez entrer des d\xe9tails suppl\xe9mentaires sur\nLe lieu qui pourraient aider \xe0 r\xe9soudre\nle probl\xe8me (par exemple, adresse, coin de rue\nou description de l\u2019emplacement).",step_4_subtitle:"Vous avez termin\xe9 ! N\u2019oubliez pas ce code!",step_4_description:"Communique avec le citoyen : \u201cLe probl\xe8me a \xe9t\xe9 captur\xe9 et sera attribu\xe9 \xe0 un repr\xe9sentant du gouvernement. Pour suivre les progr\xe8s sur ce probl\xe8me, veuillez utiliser le code ci-dessous. (Facilitateurs : encouragez le citoyen \xe0 \xe9crire ou \xe0 r\xe9p\xe9ter le code ci-dessous.\u201d\n\nRappelez au plaignant combien de temps il lui faudra pour obtenir une confirmation et une r\xe9solution.",step_4_issue_code:"R\xe9f\xe9rence de la plainte:",step_4_short_code:"SHORT CODE",step_4_two_word_code:"2-WORD CODE",step_4_back_text:"Retour \xe0 l\u2019accueil du MGP",step_5:"\xc9tape 5",step_6:"\xc9tape 6",save_button_text:"ENREGISTRER",next:"SUIVANT",submit_button_text:"ENREGISTRER",male:"Masculin",female:"F\xe9minin",other:"Autre",rather_not_say:"Pr\xe9f\xe8re ne rien dire",description_label:"Description",reported_label:"D\xe9clar\xe9/Rapport\xe9",status_label:"Status",assigned_to_label:"Assign\xe9 \xe0",reporter_label:"D\xe9clarer/Rapporter",citizen_label:"Citoyen",privacy_label:"Confidentialit\xe9",category_label:"Cat\xe9gorie",issue_type_label:"Type de plainte",attachments_label:"Pi\xe8ces jointes",comment_placeholder:"\xc9crire un commentaire...",information_not_available:"Information non disponible",confidential:"Confidentiel",overdue_label:"Plaintes dont le traitement est en retard",assigned_to_you_label:"Plaintes qui vous sont assign\xe9es",resolved_by_you_label:"Plaintes R\xe9solues par vous",average_days_label:"Nombre moyen de jours de r\xe9solution",average_satisfaction_label:"Satisfaction moyenne",your_issues_label:"Liste de vos plaintes",reported:"R\xe9port\xe9e",open:"Ouverte",assigned:"Assign\xe9e",resolved:"R\xe9solue",issue_was_accepted:"La plainte a \xe9t\xe9 accept\xe9e",issue_was_rejected:"La plainte a \xe9t\xe9 rejet\xe9e",issue_was_appealed:"Le plaignant n'est pas de la r\xe9solution, il a donc d\xe9cid\xe9 de faire appel.",issue_was_escalated:"La plainte a \xe9t\xe9 escalad\xe9e/remont\xe9e",issue_was_resolved:"La plainte a \xe9t\xe9 r\xe9solue",issue_was_rated:"La plainte a \xe9t\xe9 \xe9valu\xe9e. Le plaignant a donn\xe9 une note de: ",are_you_accepting:"Acceptez-vous qu'il s'agisse d'une plainte li\xe9e au projet ? Ou bien le rejetez-vous parce qu'il n'est pas pertinent ?",you_have_accepted:"Vous avez accept\xe9 cette plainte dans le syst\xe8me. Des notifications ont \xe9t\xe9 envoy\xe9es au citoyen et \xe0 l'enregistreur initial de la plainte.",finished:"FINALISE",actions:"ACTIONS",details:"DETAILS",history:"HISTORIQUE",days_ago:"jours \xe9coul\xe9s",view_details:"VOIR LES DETAILS",accept_issue:"Accepter une plainte",record_steps_taken:"Enregistrer les \xe9tapes parcourues",record_resolution:"Sauvegarder la r\xe9solution",rate_appeal:"Evaluer & Faire Appel",escalate:"Escalader/Remonter",lodged_by:"Inscrite par:",name:"Nom:",age:"Age:",profession:"Profession:",educational_level:"Niveau d'instruction:",type:"Type de saisie:",sub_type:"Typologie:",component:"Composante:",sub_component:"Sous Composante:",location:"Localit\xe9",category:"Cat\xe9gorie:",assigned_to:"Assign\xe9 \xe0:",decision:"D\xe9cision",satisfaction:"Satisfaction",appeal_reason:"Raison de l'appel",back:"Retour",record_steps_text:"D\xe9crivez l'activit\xe9 ci-dessous. Cela inclut les accords, les actions d'investigations ou les r\xe9sultats additionnels. N'oubliez pas d'inclure les dates lorsque cela est pertinent. peuvent consult\xe9Ces commentaires sont consultables par l'\xe9quipe, le plaignant et l'enregistreur original.",recorded_comment:"Votre commentaire a \xe9t\xe9 enregistr\xe9 et ajout\xe9 au dossier.",delete:"Supprimer",close:"Fermer",cancel:"Annuler",submit:"Soumettre",view_history:"Voir Historique",summarize_resolution:"R\xe9sumer la r\xe9solution et le r\xe9sultat.",please_confirm_resolution:"Confirmer que vous marquez cette plainte comme r\xe9solue.",confirm:"Confirmer",confirmation:"Confirmation",you_are_escalating:"Vous escaladez cette plainte \xe0 un niveau sup\xe9rieur. Veuillez indiquer la raison de l'escalade.",escalated_text:"Cette plainte a \xe9t\xe9 escalad\xe9e. Les notification seront envoy\xe9es \xe0 la personne qui l'a enregistr\xe9e et au citoyen.",accept:"ACCEPTER",reject:"REJETER",you_are_rejecting:"Vous rejetez cette plainte pour examen. Veuillez indiquer la raison.",complaint_rejected:"Cette plainte a \xe9t\xe9 rejet\xe9e. Les notification seront envoy\xe9es \xe0 la personne qui l'a enregistr\xe9e et au citoyen.",confirm_your_choice:"\xcates-vous s\xfbr de vouloir faire appel ?",confirm_deletion:"\xcates-vous s\xfbr de vouloir supprimer ?",rate_issue:"Dites-nous quelle est votre d\xe9gr\xe9 de satisfaction ?",reference:"R\xe9f\xe9rence",label_reference:"N\xb0:",label_grm:"MGP",label_category:"Cat\xe9gorie:",summary:"Votre r\xe9sum\xe9",grm_management:"Gestion de la plainte",activity_label:"Activit\xe9s",detail_title:"D\xe9tails",your_complaint_count:"Nombre de vos plaintes",your_personal_info:"Vos informations personnelles",full_name:"Nom complet",phone:"T\xe9l\xe9phone",department:"D\xe9partement",is_village_secretary:"Est s\xe9cr\xe9taire de s\xe9ance",synchronize:"Synchroniser",rating:"Evaluation",rate:"Evaluer",appeal:"Faire appel",search:"Recherche",satisfaction_level_5:"Tr\xe8s satisfait",satisfaction_level_4:"Satisfait",satisfaction_level_3:"Ni satisfait, ni insatisfait",satisfaction_level_2:"Peu satisfait",satisfaction_level_1:"Pas du tout satisfait",satisfaction_level_0:"Je souhaite faire appel",add_file:"Ajouter Pi\xe8ce jointe",do_you_want_to_attach_file:"Souhaiteriez-vous joindre un fichier ?",not_rate_yet:"Non encore \xe9valuer",recording_in_progress:"Enregistrement encours...",playing_in_progress:"Lecture encours...",warning:"Attention",by_label:"Par ",confidential_complaint:"Vous \xeates en train d'enregistrer une plainte sensible (Corruption/VBG), vous n'aurez plus acc\xe8s \xe0 celle-ci une fois l'enregistrement termin\xe9. Souhaitez-vous continuer ?",please_choose_value_for_required_field:"Merci de s\xe9lectionner une valeur pour les champs obligatoires.",no_notifications:"Aucune notification",no_attachment_to_sync:"Aucune pi\xe8ce jointe \xe0 synchronis\xe9e.",stat_nb_issue_by_age_range:"Le nombre de plainte par tranche d'\xe2ge",stat_nb_issue_by_occupation_status:"Le nombre de plainte par Situation d'occupation",stat_nb_issue_by_education_level:"Le nombre de plainte par Niveau d'instruction",stat_nb_issue_by_issue_type:"Le nombre de plainte par Type",stat_nb_issue_by_issue_category:"Le nombre de plainte par Cat\xe9gorie",stat_nb_issue_by_issue_component:"Le nombre de plainte par Composante",stat_nb_issue_by_issue_sub_component:"Le nombre de plainte par Sous Composante",stat_nb_issue_by_per_date:"Le nombre de plainte par jour"}},1843,[]);
__d(function(a,e,i,u,o,n,r){o.exports={citizen_input_header:"Kwinjiza ikibazo",used_app_before:"Wigeze ukoresha iyi porogaramu mbere?",yes:"YEGO",no:"OYA",welcome_login:"Murakaza Neza! Injirira hano.",email:"Imeri",password:"Ijambo ry'ibanga",login:"Injira",email_provided:"Shyiramo imeri wahawe n'ukuyobora kandi ukoreshe n'ijambo ry'ibanga uzajya wibuka",choose_password:"Hitamo ijambo ry'ibanga",enter_new_password:"Shyiramo Ijambo ry'ibanga.  Rigomba kuba rigizwe byibura n'inyuguti 8",last_validation:"Igenzura rya nyuma!",please_enter_code:"Shyiramo imibare wahawe n'umukoresha",account_create_success:"Konti yawe yafunguwe neza!",logout:"sohoka",diagnostics:"Isuzumabikorwa",information:"Amakuru",collect_reports:"Gukusanya raporo z'abenegihugu",search_reports:"Shakisha raporo",sync_files:"Guhuza dosiye",intro_text_0:"Icyitonderwa kubakangurambaga: ",intro_text_1:"Kuvuga ingingo zifasha abenegihugu gushyira mu ngiro. Mu gutangira, reka abantu bamenye ibi bikurikira:",intro_text_2:"Mbashimiye ibitekerezo muduhaye mutugaragariza  ibikorwa neza n'ibitagenda neza mu mushinga wacu.  uru rutonde rw'ibibazo rugizwe n'ibice 6. Biri bwihute kandi biraba byoroshye. Mbere yo gutangira hari ibintu bike mugomba kumenya.",intro_text_3:"Mwemerewe kudatanga umwirondoro wanyu niba mubishaka, Gusa kuduha amakuru ni ingenzi mu kubafasha gukemura ikibazo cyanyu",intro_text_4:"Amakuru yose muduha aradufasha kubasha kumva no gukemura ikibazo mufite. ariko ntibibahangayikishe niba ntacyo mwaba mwibuka.",intro_text_5:"Ikibazo cyawe kirabikwa muri sisiteme kandi kizakemurwa na komite ishinzwe gukemura ibibazo(GRC) mu minsi mike",intro_text_6:"Tugerageza gukemura ibibazo mwatugejejeho mugihe {x} cy\u2019umunsi mwabitanzeho.",welcome_citizen_input:"Murakaza neza!",step_1_subtitle:"Duha agaciro gakomeye ibyo mutugezaho, kandi twiuza gukorana mu gukemura ikibazo icyo aricyo cyose cyangwa mu kunoza umurimo wacu",step_1:"Intambwe ya 1",stay_touch_question:"Uburyo buhari  bw\u2019itumanaho",step_1_hint_1:"Umukangurambaga:\u201dNiba ubyifuza, dushobora kukugezahao amakuru ku kibazo cyanyu dukoresheje imeri cg ubutumwa bugufi kuri telephone. Ariko niba udashaka kugaragaza imyirondoro, turaguha kodi wakoresha ukurikirana ikibazo cyawe cyangwa se ukaba waza kundeba nkagufasha. Ushaka gukoresha ubuhe buryo?\u201d",step_1_option_1:"Kutagaragaza imyirondoro",step_1_option_2:" Kwakira amakuru ku kibazo binyuze k'umukangurambaga",step_1_option_3:"Kohererezwa amakuru",step_1_method_1:" Ubutumwa bugufi (Text / SMS)",step_1_method_2:"WhatsApp",step_1_method_3:"Imeri",step_1_placeholder_1:"Uburyo bw\u2019itumanaho",step_1_placeholder_2:" Injiza umwirondoro hano",contact_step_title:"Imyirondoro",contact_step_subtitle:"Izina ry\u2019umuntu cyangwa itsinda",contact_step_explanation:"Umukangurambaga ku muntu utifuza gutangaza imyirondoro ye: \u201cWifuje kudatangaza imyirondoro yawe, niyo mpamvu ngiye kwandika \u201cAnonymous\u201d hano\u201d \n\n Umukangurambaga kubifuza ko imyirondoro yabo itangazwa: \u201cNgiye kwandika izina ryawe hano\u201d",contact_step_placeholder_1:"Injiza izina ry\u2019ufite ikibazo",contact_step_placeholder_2:"Injiza ikiciro cy'imyaka (Singombwa)",contact_step_placeholder_3:"Hitamo igitsina (Singombwa)",contact_step_placeholder_4:"Uyu muntu ari kuzuriza ikibazo undi muntu.",step_2:"Intambwe ya 2",step_2_select_date:"Kanda hano uhitemo itariki",step_2_subtitle:"Ikibazo cyangwa ibisubizo muburyo burambuye",step_2_explanation:"Umukangurambaga: \u201cNshaka kwandika itariki ibi byabereye. Niba utibuka itariki neza ntuhangayike ikibazo cyawe kizakuriranwa\u201d",step_2_ongoing_hint:"Ibi Biracyaba cg biba inshuro nyinshi zitandukanye?",step_2_set_today:"Itariki y'uyu munsi",step_2_placeholder_1:"Ni ayahe makuru uzanye?",step_2_placeholder_2:"Hitamo ubwoko bw'ikibazo",step_2_placeholder_3:"Andika ikibazo mu magambo make",step_2_placeholder_4:"Tanga andi makuru y'ingenzi kuri iki kibazo",step_2_share_photos:"Shyiraho video, amafoto yangwa amajwi nk'ibimemyetso cg ibisobanuro",step_2_upload_attachment:"Hitamo ifoto",step_2_keep_name_confidential:"Hisha amazina yanjye. Keretse umuntu uzakemura iki kibazo niwe gusa uzabona amazina.",step_2_on_behalf_of_someone:"Ikibazo gitanzwe n'umuntu uhagarariye undi.",step_2_organization_behalf_someone:"Ni itsinda ritanze ikibazo rihagarariye undi muntu.",step_3:"Intambwe ya 3",step_3_confirmation:"Kwemeza amakuru",step_3_subtitle:"Genzura ko amakuru watanze ariyo maze ubyemeze.Niba ukeneye guhindura amakuru ayo ari yo yose, kanda buto yo guhindura.",step_3_field_title_1:"Itariki y'ikibazo:",step_3_field_title_2:"Iki ni:",step_3_field_title_3:"Iki kibazo kijyanye:",step_3_field_title_4:"Ubusobanuro ku kibazo:",step_3_attachments:"Umugereka:",step_4:"Intambwe ya 4",step_location_description:"Ibi byabereye he?",step_location_body:"Umukangurambaga: Ugomba gusobanura neza mu buryo bwumvikana aho ikibazo cyabereye\nMu gukemura ikibazo. Akarere, umudugudu, ubusobanuro ndetse n'ibiranga aho ikibazo cyabereye \nbirafasha cyane. Niba iki ari ikibazo cy'ibanga,\nhitamo kugeza ku mudugudu andi makuru uyihorere.",step_location_dropdown_placeholder:"Kanda kugirango uhitemo",step_location_input_explanation:"Injiza andi makuru yaho byabereye ashobora mu gufasha gukemura ikibazo(urugero: Munsi y'ikiraro, hirya y'inziri ku giti cy'umwembe,...).",step_4_subtitle:"Birarangiye!",step_4_description:"Ikibazo cyashyizwe muri sisiteme kandi cyagejejwe ku mukozi ubishinzwe. Kumenya aho ikibazo kigeze gikemuka, uzakoresha iyi code iri hano hepfo. (Umukangurambaga: Shishikariza Umwenegihugu kwandika iyi kode cyangwa kuyisubiramo akayifata)",step_4_issue_code:"Kode y'ikibazo:",step_4_short_code:"Kode ngufi",step_4_two_word_code:"Code y'amagambo abiri",step_4_back_text:"Subira ahabanza",step_en:"Step 5",step_5:"Intwambwe ya 5",step_6:"Intambwe ya 6",save_button_text:"BIKA & UKOMEZE",next:"IBIKURIKIRA",submit_button_text:"OHEREZA",male:"Gabo",female:"Gore",other:"Ikindi",rather_not_say:"Ahubwo ntukavuge",description_label:"Ibisobanuro",reported_label:"Byatanzwe",status_label:"Aho bigeze",assigned_to_label:"Ugishinzwe",reporter_label:"Uwatanze amakuru",citizen_label:"Umwenegihugu",privacy_label:"Kugirirwa ibanga",category_label:"Icyiciro",issue_type_label:"Ubwoko bw'ikibazo",attachments_label:"Umugereka",comment_placeholder:"Andika igitekerezo...",information_not_available:"Nta makuru ahari",confidential:"Ibanga",overdue_label:"Ibibazo byarengeje igihe",assigned_to_you_label:"Ibibazo wahawe",resolved_by_you_label:"Ibibazo byakemuwe nawe",average_days_label:"Impuzandengo y'iminsi yo gukemura ibibazo",average_satisfaction_label:"Impuzandengo yo kunyurwa",your_issues_label:"Ibibazo byawe bifunguye",open:"Ibitrakemuka",assigned:"Ibyo nshinzwe",resolved:"Ibyakemutse",issue_was_accepted:"Ikibazo cyemewe",issue_was_rejected:"Ikibazo ntikemewe",issue_was_escalated:"kibazo cyameshejwe inzego zo hejuru",issue_was_resolved:"Ikibazo cyakemutse",are_you_accepting:"Uremera ko iki kibazo kijyanye n'uyu mushinga? cyangwa ntikemewe kuberako ntaho gihuriye n'umushinga?",you_have_accepted:"Wemeye Iki kibazo muri porogaramu. Ubutumwa bwohererejwe umuturage bdetse nuwashyize ikibazo muri porogaramu.",finished:"Byarangiye",actions:"IBIKORWA",details:"BIRAMBUYE",history:"AMATEKA",days_ago:"iminsi",view_details:"Reba birambuye",accept_issue:"Emera Ikibazo",record_steps_taken:"Shyiraho Ibyakozwe",record_resolution:"Shyiraho imyanzuro",rate_appeal:"Igipimo & kujurira",escalate:"Inzego zikurikiyeho",lodged_by:"Cyashyizwemo na:",name:"Amazina:",age:"Imyaka:",location:"Aho aherereye:",category:"Ikiciro:",assigned_to:"Cyashinzwe:",decision:"Icyemezo",satisfaction:"Kunyurwa",appeal_reason:"Impamvu yo kujurira",back:"Subira Inyuma",record_steps_text:"Sibanura igikorwa hano hepfo. Hano wavuga ku bwumvikane cyangwa amasezerano yabayeho, Ibikorwa by'igenzura cyangwa iperereza, cyangwa se andi makuru yabonetse ku kibazo. Wibuke gushyiraho amatiki yingenzi. Ubu busobanuro buzabonwa n'ikipe mukorana, umuturage nyiri ikibazo, ndetse n'uwagishyize muri porogaramu.",recorded_comment:"Igitekerezo cyawe cyanditswe ndetse cyashyizwe no muro porogaramu.",cancel:"Hagarika",submit:"Ohereza",view_history:"Reba ibyahise",summarize_resolution:"Andika mu magambo make umwanzuro wafashwe ndetse nibyavuyemo.",please_confirm_resolution:"Emeza ko iki kibazo cyakemutse.",confirm:"Emeza",you_are_escalating:"Iki kibazo ugiye kugishinga inzego zo hejuru. SObanura neza impamvu itumye ucyohereza mu nzego zigukuriye",escalated_text:"Iki kibazo cyoherejwe ku nzego zo hejuru. NUbutumwa burohererezwa uwagishyize muri porogaramu ndetse no ku muturage.",accept:"Cyemere",reject:"Cyange",you_are_rejecting:"Wanze iki kibazo ngo ntikazakemurwe muri uyu mushinga.\nSobanura neza impamvu.",complaint_rejected:"Iki kibazo ntabwo cyemewe. Ubutumwa burohererezwa uwagishyize muri porogaramu ndetse n'umuturage."}},1844,[]);
